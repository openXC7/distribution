# Bank 14 of xc7k325tffg676 is high-range (LIOB33).
# F22 is IO_L12P_T1_MRCC_14. D23/D24 are IO_L11P/N_T1_SRCC_14,
# tile LIOB33_X0Y127. J26 is IO_L18P_T2_A12_D28_14.
set_property PACKAGE_PIN F22 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property PACKAGE_PIN D23 [get_ports din_p]
set_property IOSTANDARD LVDS_25 [get_ports din_p]
set_property PACKAGE_PIN D24 [get_ports din_n]
set_property IOSTANDARD LVDS_25 [get_ports din_n]
set_property PACKAGE_PIN J26 [get_ports led]
set_property IOSTANDARD LVCMOS33 [get_ports led]
